# Cloudbeds partner sandbox integration — automatic API-key delivery
# These values come from the Cloudbeds Partner App Details page.
CLOUDBEDS_ENVIRONMENT=sandbox
CLOUDBEDS_SANDBOX_ONLY=true
CLOUDBEDS_CLIENT_ID=
CLOUDBEDS_CLIENT_SECRET=
CLOUDBEDS_REDIRECT_URI=https://api.sem-management.com/api/integrations/cloudbeds/callback

# Must match the scopes enabled on the Cloudbeds App Details OAuth URL.
CLOUDBEDS_AUTH_SCOPES=read:customFields read:dashboard read:guest read:hotel read:housekeeping read:reservation read:resourceReservations read:room

# Official Cloudbeds PMS v1.3 endpoints.
CLOUDBEDS_API_BASE=https://api.cloudbeds.com/api/v1.3
CLOUDBEDS_AUTH_BASE=https://hotels.cloudbeds.com/api/v1.3

# Public PMS URL used by Cloudbeds callbacks and guest secure links.
PMS_FRONTEND_URL=https://pms.sem-management.com
GUEST_PORTAL_TOKEN_TTL_DAYS=30

# Guest email delivery (Hostinger SMTP over SSL/TLS).
# Keep SMTP_PASS only in /home/deployer/pms-secrets/backend.env on the production VPS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@iluma.gr
SMTP_PASS=
SMTP_FROM=support@iluma.gr
GUEST_EMAIL_FROM=support@iluma.gr

# Optional safety pin. Automatic delivery should normally discover the property.
# Only enable this when you intentionally want a hard allowlist.
CLOUDBEDS_ENFORCE_PROPERTY_ALLOWLIST=false
CLOUDBEDS_ALLOWED_PROPERTY_IDS=

# Sandbox reconnects normally bind back to the same property.
# Set true only if this sandbox is intentionally moved to a different property.
CLOUDBEDS_ALLOW_REBIND=false

# IMPORTANT:
# Automatic delivery stores the cbat_ API key encrypted in MariaDB.
# Do NOT put an old automatic-delivery key here.
# A manually generated self-service key is accepted only when the opt-in flag
# below is explicitly enabled for local troubleshooting.
CLOUDBEDS_ALLOW_ENV_API_KEY=false
CLOUDBEDS_API_KEY=

# Used to encrypt automatically delivered API keys in MariaDB.
# Use a long random secret and keep it stable across deployments.
INTEGRATION_SECRET=

# Existing application secrets / database settings are still required.
JWT_SECRET=
