# Cloudbeds partner sandbox integration
CLOUDBEDS_ENVIRONMENT=sandbox
CLOUDBEDS_SANDBOX_ONLY=true
CLOUDBEDS_CLIENT_ID=
CLOUDBEDS_CLIENT_SECRET=
CLOUDBEDS_REDIRECT_URI=https://api.sem-management.com/api/integrations/cloudbeds/callback

# Optional: pin the integration to one or more test property IDs (comma-separated).
# Leave empty during the first sandbox connection, then fill it with the returned property ID(s).
CLOUDBEDS_ALLOWED_PROPERTY_IDS=
CLOUDBEDS_ALLOW_REBIND=false

# Optional shortcut for a self-service sandbox API key.
# If set, it takes precedence over the API key obtained by automatic delivery.
CLOUDBEDS_API_KEY=

CLOUDBEDS_API_BASE=https://api.cloudbeds.com/api/v1.3
CLOUDBEDS_AUTH_BASE=https://hotels.cloudbeds.com/api/v1.3

# Used to encrypt automatically-delivered Cloudbeds API keys stored in MariaDB.
# Use a long random secret. If omitted, JWT_SECRET is used as a fallback.
INTEGRATION_SECRET=
